  "adaptationRequirements": [
    "Keep generated 3D geometry volumetric; map APK screen-layer semantics to mesh movement rather than flattening the watch.",
    "Classic diamond cross-close during every hero switch is a requested project enhancement, not an observed ordinary APK behavior.",
    "Hold web busy states through the visual phase; APK raw state flags can switch earlier than every layer finishes.",
    "Dispose animations, timers, video and looping audio on UI teardown and mode change.",
    "Use palette-based portrait tinting, as the APK also separates owner-style color filtering from hero resources."
  ],
  "excludedFromOrdinaryFlow": [
    "MainActivity.l(): randomizer activation, not ordinary opening",
    "rotate.xml infinite decorative turn; randomizer/scanner XMLs are special effects",
    "special hero video/sequence, evolution, damage, scan, timeout branches"
  ],
